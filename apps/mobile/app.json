{
  "expo": {
    "name": "LAABS Video Vault",
    "slug": "laabs-video-vault",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/app.icon",
      "supportsTablet": true,
      "bundleIdentifier": "com.markmccoid.laabs-video-vault",
      "config": {
        "usesNonExemptEncryption": false
      },
      "entitlements": {
        "com.apple.security.application-groups": [
          "group.com.markmccoid.laabs-video-vault"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.markmccoid.laabsvideovault"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "scheme": "laabsvideovault",
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-image",
      "@bacons/apple-targets"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "build": {
          "experimental": {
            "ios": {
              "appExtensions": [
                {
                  "bundleIdentifier": "com.markmccoid.laabs-video-vault.share",
                  "targetName": "ShareExtension",
                  "entitlements": {
                    "com.apple.security.application-groups": [
                      "group.com.markmccoid.laabs-video-vault"
                    ]
                  }
                }
              ]
            }
          }
        },
        "projectId": "d91dc07b-981f-4234-a586-fdceb2fc947f"
      }
    }
  }
}
