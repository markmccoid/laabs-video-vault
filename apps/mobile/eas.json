{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": { "simulator": true },
      "env": { "EXPO_PUBLIC_CONVEX_URL": "https://fine-bass-237.convex.cloud" }
    },
    "preview": {
      "distribution": "store",
      "autoIncrement": true,
      "env": { "EXPO_PUBLIC_CONVEX_URL": "https://fine-bass-237.convex.cloud" }
    },
    "production": {
      "autoIncrement": true,
      "env": { "EXPO_PUBLIC_CONVEX_URL": "https://acoustic-rhinoceros-246.convex.cloud" }
    }
  },
  "submit": {
    "preview": { "ios": {} },
    "production": { "ios": {} }
  }
}
