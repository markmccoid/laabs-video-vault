{
  "name": "laabs-video-vault",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "packageManager": "npm@11.19.0",
  "scripts": {
    "dev:backend": "npm run dev -w @lvv/backend",
    "dev:mobile": "npm run start -w @lvv/mobile",
    "dev:desktop": "npm run dev -w @lvv/desktop",
    "dev:extension": "npm run dev -w @lvv/extension",
    "build:extension": "npm run build -w @lvv/extension",
    "ios": "npm run ios -w @lvv/mobile",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "turbo": "^2.11.12"
  },
  "overrides": {
    "react": "19.3.0"
  }
}
